# Rust
/target/
**/*.rs.bk

# Node / UI
node_modules/
/ui/dist/
*.tsbuildinfo
coverage/

# Python verification tools
__pycache__/

# Tauri
/src-tauri/target/
/src-tauri/gen/schemas/
# Regenerated by tauri-build from the app manifest in src-tauri/build.rs
/src-tauri/permissions/autogenerated/

# Local data, logs and secrets (never commit real or patient data)
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.log
.env
.env.*
/local-data/

# Local development history and generated review evidence
/.local/quality-history/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Agent session state
/.claude/scheduled_tasks.lock
/.playwright-cli/
/.impeccable/hook.cache.json

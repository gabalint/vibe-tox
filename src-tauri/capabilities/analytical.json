{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "analytical",
  "description": "Instrument readiness, source registration, lot, preparation, worklist, run, QC and deviation commands the main window may call (NFR-31). The engine checks each command's capability.",
  "windows": ["main"],
  "permissions": [
    "allow-list-instrument-readiness",
    "allow-list-source-registrations",
    "allow-register-source",
    "allow-approve-source",
    "allow-list-lots",
    "allow-register-lot",
    "allow-withdraw-lot",
    "allow-create-prep-batch",
    "allow-record-prep-step",
    "allow-list-worklist",
    "allow-create-run",
    "allow-get-run",
    "allow-list-runs",
    "allow-add-patient-position",
    "allow-add-qc-position",
    "allow-fail-execution",
    "allow-close-run",
    "allow-get-run-qc",
    "allow-assess-qc",
    "allow-open-deviation",
    "allow-close-deviation",
    "allow-set-instrument-status",
    "allow-complete-prep-batch",
    "allow-resolve-qc-conflict",
    "allow-get-prep-batch",
    "allow-list-prep-batches",
    "allow-record-run-performing-site",
    "allow-get-deviation"
  ]
}

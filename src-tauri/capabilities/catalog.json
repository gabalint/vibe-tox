{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "catalog",
  "description": "The catalog commands the main window may call (NFR-31).",
  "windows": ["main"],
  "permissions": [
    "allow-list-specimen-types",
    "allow-create-specimen-type",
    "allow-list-analytes",
    "allow-create-analyte",
    "allow-update-analyte",
    "allow-analyte-history",
    "allow-analyte-usage",
    "allow-list-methods",
    "allow-create-method",
    "allow-list-orderables",
    "allow-create-orderable",
    "allow-list-active-orderables",
    "allow-list-method-versions",
    "allow-get-method-version",
    "allow-draft-method-version",
    "allow-update-method-draft",
    "allow-approve-method-version",
    "allow-retire-method-version",
    "allow-list-orderable-versions",
    "allow-get-orderable-version",
    "allow-draft-orderable-version",
    "allow-update-orderable-draft",
    "allow-approve-orderable-version",
    "allow-retire-orderable-version",
    "allow-list-validity-policy-versions",
    "allow-get-validity-policy",
    "allow-draft-validity-policy-version",
    "allow-update-validity-policy-draft",
    "allow-approve-validity-policy-version",
    "allow-retire-validity-policy-version",
    "allow-standard-catalog-tree",
    "allow-load-standard-catalog",
    "allow-standard-catalog-status",
    "allow-generate-catalog-preview",
    "allow-list-catalog-previews",
    "allow-view-catalog-preview-pdf",
    "allow-export-catalog-preview-pdf",
    "allow-approve-reviewed-catalog"
  ]
}

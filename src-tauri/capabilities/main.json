{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Commands the main window may call (NFR-31). Grant each new app command here and list it in build.rs; grant no shell, file system or HTTP plugin.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-security-key-signup",
    "allow-acknowledge-key-recovery",
    "allow-security-key-sign-in",
    "allow-security-key-unlock",
    "allow-security-key-enroll",
    "allow-security-key-recover",
    "allow-get-authentication-status",
    "allow-list-key-sign-in-choices",
    "allow-revoke-security-key",
    "allow-security-key-action",
    "allow-security-key-status",
    "allow-security-key-pin",
    "allow-security-key-cancel",
    "allow-security-key-continue",
    "allow-setup-status",
    "allow-create-first-administrator",
    "allow-sign-in",
    "allow-change-initial-password",
    "allow-verify-mfa",
    "allow-current-session",
    "allow-touch-session",
    "allow-lock-session",
    "allow-unlock-session",
    "allow-get-unlock-pin-status",
    "allow-set-unlock-pin",
    "allow-disable-unlock-pin",
    "allow-unlock-with-pin",
    "allow-sign-out",
    "allow-change-password",
    "allow-list-roles",
    "allow-list-users",
    "allow-create-user",
    "allow-set-user-roles",
    "allow-disable-user",
    "allow-enable-user",
    "allow-reset-user-credentials",
    "allow-designate-one-person-laboratory",
    "allow-list-audit-events",
    "allow-verify-audit-chain",
    "allow-list-listener-status"
  ]
}

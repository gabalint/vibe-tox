{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Steady State LIMS",
  "identifier": "org.vibetox.lis",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Steady State LIMS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "publisher": "OpenBGA",
    "copyright": "Copyright 2026 Steady State LIMS contributors",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "category": "Medical",
    "shortDescription": "A local laboratory information system for clinical toxicology.",
    "longDescription": "A free, local laboratory information system for managing clinical toxicology work on one laboratory computer.",
    "fileAssociations": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
